RunService:BindToRenderStep(
	"MarquisAimLock",
	Enum.RenderPriority.Camera.Value + 1,
	function()

		if not lockOn then
			return
		end

		target =
			getClosestTarget()

		if not target then
			return
		end

		local character =
			target.Character

		if not character then
			return
		end

		local head =
			character:FindFirstChild("Head")

		local camera =
			workspace.CurrentCamera

		if head and camera then

			camera.CFrame =
				CFrame.lookAt(
					camera.CFrame.Position,
					head.Position
				)

		end
	end
)

--==================================================
-- GET DROPPED GUN
--==================================================

local gunTeleporting = false

gunBtn.MouseButton1Click:Connect(function()

	if gunTeleporting then
		return
	end

	local gun =
		workspace:FindFirstChild(
			"GunDrop",
			true
		)

	if not gun then

		buttonBounce(gunBtn)

		showNotification(
			"No dropped gun found."
		)

		return
	end

	local character =
		plr.Character

	if not character then
		return
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not root then
		return
	end

	local gunPart

	if gun:IsA("BasePart") then

		gunPart = gun

	else

		gunPart =
			gun:FindFirstChildWhichIsA(
				"BasePart",
				true
			)

	end

	if not gunPart then

		showNotification(
			"Could not find the gun part."
		)

		return
	end

	buttonBounce(gunBtn)

	local originalCFrame =
		root.CFrame

	gunTeleporting = true
	gunBtn.Text = "Getting Gun..."

	showNotification(
		"Teleporting to dropped gun..."
	)

	root.CFrame =
		gunPart.CFrame +
		Vector3.new(0,3,0)

	task.wait(.5)

	if root
		and root.Parent
		and character
		and character.Parent then

		root.CFrame =
			originalCFrame

	end

	gunBtn.Text =
		"Get Dropped Gun"

	gunTeleporting = false

	showNotification(
		"Returned to your original position."
	)

end)

--==================================================
-- GUN DROP DETECTOR
--==================================================

local gunWasPresent = false

local function checkGunDrop()

	local gun =
		workspace:FindFirstChild(
			"GunDrop",
			true
		)

	if gun then

		if not gunWasPresent then

			gunWasPresent = true

			if esp then
				updateGunESP()
			end

			if notifyGunDropped then

				showNotification(
					"Gun dropped"
				)

			end
		end

	else

		gunWasPresent = false

		clearGunESP()

	end

	if esp and gun and gun ~= lastGun then
		updateGunESP()
	end

end

RunService.Heartbeat:Connect(
	checkGunDrop
)


--==================================================
-- PLAYER ESP
--==================================================

local function clearESP(player)

	if highlights[player] then
		highlights[player]:Destroy()
		highlights[player] = nil
	end

	if boxes[player] then
		boxes[player]:Destroy()
		boxes[player] = nil
	end

	if nameTags[player] then
		nameTags[player]:Destroy()
		nameTags[player] = nil
	end
end

local function updateESP(player)

	clearESP(player)

	if not esp or player == plr then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local highlight = Instance.new("Highlight")

	highlight.Name = "MarquisESP"
	highlight.Adornee = character

	highlight.FillColor =
		Color3.fromRGB(70,150,255)

	highlight.OutlineColor =
		Color3.fromRGB(255,255,255)

	highlight.FillTransparency = .8
	highlight.OutlineTransparency = 0

	highlight.DepthMode =
		xray
		and Enum.HighlightDepthMode.AlwaysOnTop
		or Enum.HighlightDepthMode.Occluded

	highlight.Parent = character

	highlights[player] = highlight

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not root then
		return
	end

	local box =
		Instance.new("BoxHandleAdornment")

	box.Name = "MarquisHitboxESP"
	box.Adornee = root

	box.Size = Vector3.new(
		hitboxSize,
		hitboxSize * 1.5,
		hitboxSize / 2
	)

	box.Color3 =
		Color3.fromRGB(70,150,255)

	box.Transparency = .35
	box.AlwaysOnTop = xray
	box.ZIndex = 5
	box.Parent = character

	boxes[player] = box

	local head =
		character:FindFirstChild("Head")

	if head then

		local billboard =
			Instance.new("BillboardGui")

		billboard.Name = "MarquisESPName"
		billboard.Adornee = head
		billboard.Size =
			UDim2.fromOffset(200,35)

		billboard.StudsOffset =
			Vector3.new(0,3.2,0)

		billboard.AlwaysOnTop = true
		billboard.ZIndexBehavior =
			Enum.ZIndexBehavior.Sibling

		billboard.Parent = head

		local nameLabel =
			Instance.new("TextLabel")

		nameLabel.Size =
			UDim2.fromScale(1,1)

		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = player.Name

		nameLabel.TextColor3 =
			Color3.fromRGB(255,255,255)

		nameLabel.TextSize = 14
		nameLabel.Font =
			Enum.Font.GothamBold

		nameLabel.TextStrokeColor3 =
			Color3.fromRGB(0,0,0)

		nameLabel.TextStrokeTransparency = .25

		nameLabel.TextXAlignment =
			Enum.TextXAlignment.Center

		nameLabel.Parent = billboard

		nameTags[player] = billboard
	end
end

local function updateAllESP()

	for _,player in ipairs(
		Players:GetPlayers()
	) do

		updateESP(player)

	end
end

--==================================================
-- GUN ESP
--==================================================

local function clearGunESP()

	if gunESPHighlight then
		gunESPHighlight:Destroy()
		gunESPHighlight = nil
	end

	if gunESPBox then
		gunESPBox:Destroy()
		gunESPBox = nil
	end

	if gunESPName then
		gunESPName:Destroy()
		gunESPName = nil
	end

	lastGun = nil
end

local function updateGunESP()

	clearGunESP()

	if not esp then
		return
	end

	local gun =
		workspace:FindFirstChild(
			"GunDrop",
			true
		)

	if not gun then
		return
	end

	local gunPart

	if gun:IsA("BasePart") then

		gunPart = gun

	else

		gunPart =
			gun:FindFirstChildWhichIsA(
				"BasePart",
				true
			)

	end

	if not gunPart then
		return
	end

	lastGun = gun

	local highlight =
		Instance.new("Highlight")

	highlight.Name =
		"MarquisGunESP"

	highlight.Adornee = gun

	highlight.FillColor =
		Color3.fromRGB(70,150,255)

	highlight.OutlineColor =
		Color3.fromRGB(255,255,255)

	highlight.FillTransparency = .55
	highlight.OutlineTransparency = 0

	highlight.DepthMode =
		xray
		and Enum.HighlightDepthMode.AlwaysOnTop
		or Enum.HighlightDepthMode.Occluded

	highlight.Parent = gun

	gunESPHighlight = highlight

	local box =
		Instance.new("BoxHandleAdornment")

	box.Name =
		"MarquisGunBox"

	box.Adornee = gunPart

	box.Size =
		gunPart.Size +
		Vector3.new(1,1,1)

	box.Color3 =
		Color3.fromRGB(70,150,255)

	box.Transparency = .25
	box.AlwaysOnTop = xray
	box.ZIndex = 5
	box.Parent = gunPart

	gunESPBox = box

	local billboard =
		Instance.new("BillboardGui")

	billboard.Name =
		"MarquisGunName"

	billboard.Adornee = gunPart

	billboard.Size =
		UDim2.fromOffset(100,30)

	billboard.StudsOffset =
		Vector3.new(0,2,0)

	billboard.AlwaysOnTop = true
	billboard.ZIndexBehavior =
		Enum.ZIndexBehavior.Sibling

	billboard.Parent = gunPart

	local label =
		Instance.new("TextLabel")

	label.Size =
		UDim2.fromScale(1,1)

	label.BackgroundTransparency = 1
	label.Text = "GUN"

	label.TextColor3 =
		Color3.fromRGB(255,255,255)

	label.TextSize = 14
	label.Font =
		Enum.Font.GothamBold

	label.TextStrokeColor3 =
		Color3.fromRGB(0,0,0)

	label.TextStrokeTransparency = .2

	label.TextXAlignment =
		Enum.TextXAlignment.Center

	label.Parent = billboard

	gunESPName = billboard

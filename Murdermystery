--==================================================
-- AIM LOCK
--==================================================

local function getClosestTarget()

	local camera =
		workspace.CurrentCamera

	if not camera then
		return nil
	end

	local center = Vector2.new(
		camera.ViewportSize.X / 2,
		camera.ViewportSize.Y / 2
	)

	local closest = nil
	local closestDistance = math.huge

	for _,player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= plr
			and player.Character then

			local humanoid =
				player.Character:
				FindFirstChildOfClass("Humanoid")

			local head =
				player.Character:
				FindFirstChild("Head")

			if humanoid
				and humanoid.Health > 0
				and head then

				local position,visible =
					camera:WorldToViewportPoint(
						head.Position
					)

				if visible
					and position.Z > 0 then

					local distance =
						(
							Vector2.new(
								position.X,
								position.Y
							) - center
						).Magnitude

					if distance <
						closestDistance then

						closestDistance =
							distance

						closest =
							player

					end
				end
			end
		end
	end

	return closest
end


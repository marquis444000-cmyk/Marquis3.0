local notificationNumber = 0

local function showNotification(message)

	notificationNumber += 1
	local current = notificationNumber

	notificationText.Text = message
	notification.Visible = true

	notification.BackgroundTransparency = 1
	notificationText.TextTransparency = 1

	TweenService:Create(
		notification,
		TweenInfo.new(.2),
		{BackgroundTransparency = 0}
	):Play()

	TweenService:Create(
		notificationText,
		TweenInfo.new(.2),
		{TextTransparency = 0}
	):Play()

	task.delay(2,function()

		if current ~= notificationNumber then
			return
		end

		local fadeFrame = TweenService:Create(
			notification,
			TweenInfo.new(.25),
			{BackgroundTransparency = 1}
		)

		local fadeText = TweenService:Create(
			notificationText,
			TweenInfo.new(.25),
			{TextTransparency = 1}
		)

		fadeFrame:Play()
		fadeText:Play()

		fadeFrame.Completed:Wait()

		if current == notificationNumber then
			notification.Visible = false
		end

	end)
end

